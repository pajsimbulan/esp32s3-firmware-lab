# Board: ESP32-S3 N16R8 (16 MB flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# OTA: two app slots from partitions.csv, rollback if the new image fails
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The lab serves the image from a local HTTP server
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# Wi-Fi via protocol_examples_common. Set your SSID and password in
# idf.py menuconfig > Example Connection Configuration. They stay in the
# git-ignored sdkconfig, never in this file.
CONFIG_EXAMPLE_CONNECT_WIFI=y
