# Board: ESP32-S3 N16R8 (16 MB flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Wi-Fi via protocol_examples_common. Set your SSID and password in
# idf.py menuconfig > Example Connection Configuration. They stay in the
# git-ignored sdkconfig, never in this file.
CONFIG_EXAMPLE_CONNECT_WIFI=y
